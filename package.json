{
  "name": "gukjang-radar",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "lint": "turbo run lint && eslint scripts",
    "typecheck": "turbo run typecheck",
    "check-enum-sync": "tsx scripts/check-enum-sync.ts",
    "lint-forbidden-words": "tsx scripts/lint-forbidden-words.ts",
    "verify-name-index": "tsx scripts/verify-name-index.ts",
    "manual-verify-dart-sync": "tsx scripts/manual-verify-dart-sync.ts",
    "manual-verify-news-pipeline": "tsx scripts/manual-verify-news-pipeline.ts",
    "manual-verify-analysis": "tsx scripts/manual-verify-analysis.ts",
    "manual-verify-connections": "tsx scripts/manual-verify-connections.ts",
    "manual-verify-counter-check": "tsx scripts/manual-verify-counter-check.ts",
    "manual-verify-market-snapshot": "tsx scripts/manual-verify-market-snapshot.ts",
    "manual-verify-w8-alerts": "tsx scripts/manual-verify-w8-alerts.ts",
    "manual-verify-bookmarks": "tsx scripts/manual-verify-bookmarks.ts",
    "manual-verify-feedback-promotion": "tsx scripts/manual-verify-feedback-promotion.ts",
    "manual-verify-market-rescore": "tsx scripts/manual-verify-market-rescore.ts",
    "manual-verify-canonical-merge": "tsx scripts/manual-verify-canonical-merge.ts",
    "manual-verify-review-recalc": "tsx scripts/manual-verify-review-recalc.ts",
    "manual-verify-entity-subtype-upsert": "tsx scripts/manual-verify-entity-subtype-upsert.ts",
    "golden": "tsx scripts/run-golden.ts",
    "db:generate": "pnpm --filter @gukjang/db generate",
    "db:migrate": "pnpm --filter @gukjang/db migrate",
    "db:reset": "pnpm --filter @gukjang/db reset",
    "db:seed": "pnpm --filter @gukjang/db seed",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@gukjang/core": "workspace:*",
    "@gukjang/db": "workspace:*",
    "@gukjang/spec": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "esbuild",
      "msgpackr-extract",
      "sharp"
    ]
  }
}
