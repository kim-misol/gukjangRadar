# ── DB ─────────────────────────────────────────────
DATABASE_URL=postgres://gukjang:gukjang@localhost:5432/gukjang_radar

# ── Redis / Queue ──────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── LLM (Claude API) ───────────────────────────────
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_DAILY_COST_CAP_USD=20

# ── 시세 (KIS Open API) ────────────────────────────
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=

# ── 기업/지배구조 (OpenDART) ────────────────────────
DART_API_KEY=

# ── 웹앱 ───────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 인증 ───────────────────────────────────────────
JWT_SECRET=change-me-in-production
SESSION_COOKIE_NAME=gr_session

# ── 웹푸시 ─────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── 런타임 ─────────────────────────────────────────
NODE_ENV=development
PORT=4000
# FREE | PRO | PRO_PLUS 과금 기능 플래그. V1은 항상 false로 둔다 (PRD D1).
FEATURE_PAID_PLANS_ENABLED=false
