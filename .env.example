# ── DB ─────────────────────────────────────────────
DATABASE_URL=postgres://gukjang:gukjang@localhost:5432/gukjang_radar

# ── Redis / Queue ──────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── LLM (Claude API) ───────────────────────────────
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_DAILY_COST_CAP_USD=20

# ── 시세 (KIS Open API) ────────────────────────────
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=

# ── 기업/지배구조 (OpenDART) ────────────────────────
DART_API_KEY=

# ── 웹앱 ───────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 인증 ───────────────────────────────────────────
JWT_SECRET=change-me-in-production
SESSION_COOKIE_NAME=gr_session

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# T4.2 관리자 검수 큐 — 1인 운영 V1의 임시 공유 시크릿(role 클레임 아님, docs/15 W8)
ADMIN_API_TOKEN=

# ── 에러 추적 (T5.4, Sentry — DSN 없으면 비활성) ────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# 소스맵 업로드(next build 시)용 — CI에서만 필요, 로컬 개발엔 불필요
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── 웹푸시 (VAPID는 외부 계정 없이 로컬에서 직접 생성 가능 — npx web-push generate-vapid-keys) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@gukjang-radar.kr
# 브라우저에 노출되는 공개키 — 위 VAPID_PUBLIC_KEY와 항상 같은 값을 넣는다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── 런타임 ─────────────────────────────────────────
NODE_ENV=development
PORT=4000
# FREE | PRO | PRO_PLUS 과금 기능 플래그. V1은 항상 false로 둔다 (PRD D1).
FEATURE_PAID_PLANS_ENABLED=false
